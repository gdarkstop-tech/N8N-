    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "r1", "name": "request_id", "value": "={{ $('Summarise Conflicts').item.json.request_id }}", "type": "string" },
            { "id": "r2", "name": "channel", "value": "google_calendar", "type": "string" },
            { "id": "r3", "name": "tier", "value": "T2", "type": "string" },
            { "id": "r4", "name": "title", "value": "={{ $('Summarise Conflicts').item.json.title }}", "type": "string" },
            { "id": "r5", "name": "conflict_count", "value": "={{ $('Summarise Conflicts').item.json.conflict_count }}", "type": "string" },
            { "id": "r6", "name": "decision", "value": "rejected", "type": "string" },
            { "id": "r7", "name": "outcome", "value": "not_created", "type": "string" },
