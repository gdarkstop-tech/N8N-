      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\n// --- shared helpers (inline: n8n Code nodes cannot import) ---\n\n// Deterministic content hash for idempotency.\n// Execution id is NOT a usable idempotency key: a double form submit creates two\n// executions with two different ids, so it could never match. The key must be\n// derived from the CONTENT of the request.\nfunction fnv1a(str) {\n  let h = 0x811c9dc5;\n  for (let i = 0; i < str.length; i++) {\n    h ^= str.charCodeAt(i);\n    h = Math.imul(h, 0x01000193) >>> 0;\n  }\n  return ('00000000' + h.toString(16)).slice(-8);\n}\nfunction dedupeKey(parts) {\n  const norm = parts\n    .map(function (p) { return String(p == null ? '' : p).trim().toLowerCase().replace(/\\s+/g, ' '); })\n    .join('|~|');\n  const rev = norm.split('').reverse().join('');\n  return fnv1a(norm) + fnv1a(rev) + String(norm.length);\n}\n\n// n8n hardcodes parse_mode 'Markdown' on sendAndWait. Legacy Markdown throws\n// \"Bad Request: can't parse entities\" on any unmatched * _ ` [ ] \u2014 which real\n// email WILL contain. Escaping is unreliable in legacy mode, so neutralise the\n// characters instead. Costs a little fidelity, never a failed send.\nfunction mdSafe(s) {\n  return String(s == null ? '' : s).replace(/[*_`\\[\\]]/g, ' ');\n}\n\n// Where we control parse_mode we use HTML, whose escaping is total and lossless.\nfunction htmlEsc(s) {\n  return String(s == null ? '' : s)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n}\n\n// Prefix U+200F so a mixed LTR-label / RTL-content line renders right-to-left.\nfunction rtlMark(s) {\n  const str = String(s == null ? '' : s);\n  const ARABIC = /[\u0600-\u06ff\u0750-\u077f\u08a0-\u08ff\ufb50-\ufdff\ufe70-\ufeff]/;\n  return ARABIC.test(str) ? '\u200f' + str : str;\n}\n\n// Telegram hard-caps a message at 4096 chars. Split on paragraph, then line, then\n// hard-cut, so a long email is delivered in full across several messages rather\n// than failing to send.\nfunction chunk(text, size) {\n  const out = [];\n  let buf = '';\n  const paras = String(text == null ? '' : text).split(/\\n\\n+/);\n  for (const para of paras) {\n    for (const line of para.split('\\n')) {\n      let l = line;\n      while (l.length > size) {\n        if (buf) { out.push(buf); buf = ''; }\n        out.push(l.slice(0, size));\n        l = l.slice(size);\n      }\n      if ((buf + '\\n' + l).length > size) { out.push(buf); buf = l; }\n      else { buf = buf ? buf + '\\n' + l : l; }\n    }\n    if ((buf + '\\n\\n').length < size) { buf += '\\n\\n'; }\n  }\n  if (buf.trim()) out.push(buf);\n  return out.length ? out : ['(empty)'];\n}\n\n// RFC-ish address check. Deliberately strict-ish and deterministic: validation is\n// infrastructure's job, never the model's.\nfunction validEmail(a) {\n  return /^[^\\s@,;]+@[^\\s@,;]+\\.[^\\s@,;]{2,}$/.test(String(a == null ? '' : a).trim());\n}\nfunction splitAddrs(s) {\n  return String(s == null ? '' : s).split(/[,;]/).map(function (x) { return x.trim(); }).filter(Boolean);\n}\n\nconst f = $input.first().json;\n\nconst title       = f['Title'] || '';\nconst startRaw    = f['Start'] || '';\nconst endRaw      = f['End'] || '';\nconst attendees   = f['Attendees'] || '';\nconst description = f['Description'] || '';\n\n// --- deterministic datetime validation, before anything reaches approval ---\nconst errors = [];\nconst start = new Date(startRaw);\nconst end   = new Date(endRaw);\n\nif (isNaN(start.getTime())) errors.push('Start is not a valid date/time: ' + startRaw);\nif (isNaN(end.getTime()))   errors.push('End is not a valid date/time: ' + endRaw);\nif (!isNaN(start.getTime()) && !isNaN(end.getTime())) {\n  if (end.getTime() <= start.getTime()) errors.push('End must be after Start');\n  if (end.getTime() - start.getTime() > 1000 * 60 * 60 * 24 * 7) {\n    errors.push('Event is longer than 7 days - probably a typo');\n  }\n  if (start.getTime() < Date.now() - 1000 * 60 * 5) {\n    errors.push('Start is in the past: ' + start.toISOString());\n  }\n}\nif (!String(title).trim()) errors.push('Title is empty');\nfor (const a of splitAddrs(attendees)) {\n  if (!validEmail(a)) errors.push('Invalid attendee address: ' + a);\n}\n\nconst ok = errors.length === 0;\nconst WIDEN = 12 * 60 * 60 * 1000;\n\nreturn [{\n  json: {\n    request_id: String($execution.id),\n    dedupe_key: dedupeKey(['google_calendar', title, startRaw, endRaw, attendees]),\n    channel: 'google_calendar',\n    title: title,\n    start: ok ? start.toISOString() : '',\n    end:   ok ? end.toISOString()   : '',\n    // Widened probe window. Narrow windows miss events that begin earlier and run in.\n    probe_start: ok ? new Date(start.getTime() - WIDEN).toISOString() : '',\n    probe_end:   ok ? new Date(end.getTime()   + WIDEN).toISOString() : '',\n    attendees: splitAddrs(attendees).join(','),\n    description: description,\n    valid: ok,\n    validation_error: errors.join('; '),\n  },\n}];\n"
      },
