{
  "nodes": [
    {
      "parameters": {
        "formTitle": "ALIA — Create Calendar Event (Google)",
        "formDescription": "Checks for conflicts, then requires approval before the event is created.",
        "formFields": {
          "values": [
            { "fieldLabel": "Title", "requiredField": true },
            { "fieldLabel": "Start", "placeholder": "2026-09-22T14:00:00+03:00", "requiredField": true },
            { "fieldLabel": "End", "placeholder": "2026-09-22T15:00:00+03:00", "requiredField": true },
            { "fieldLabel": "Attendees", "placeholder": "a@x.com, b@y.com" },
            { "fieldLabel": "Description", "fieldType": "textarea" }
          ]
        },
        "options": {}
      },
      "id": "alia-form-gcal",
      "name": "Request Event (Google)",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [-220, 300],
      "webhookId": "alia-gcal-request"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "request_id", "value": "={{ $execution.id }}", "type": "string" },
            { "id": "a2", "name": "channel", "value": "google_calendar", "type": "string" },
            { "id": "a3", "name": "tier", "value": "T2", "type": "string" },
            { "id": "a4", "name": "title", "value": "={{ $json.Title }}", "type": "string" },
            { "id": "a5", "name": "start", "value": "={{ $json.Start }}", "type": "string" },
            { "id": "a6", "name": "end", "value": "={{ $json.End }}", "type": "string" },
            { "id": "a7", "name": "attendees", "value": "={{ $json.Attendees || '' }}", "type": "string" },
            { "id": "a8", "name": "description", "value": "={{ $json.Description || '' }}", "type": "string" },
            { "id": "a9", "name": "requested_at", "value": "={{ $now.toISO() }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "alia-gcal-build",
      "name": "Build Request",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [0, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "", "mode": "list", "cachedResultName": "" },
        "sheetName": { "__rl": true, "value": "", "mode": "list", "cachedResultName": "" },
        "columns": { "mappingMode": "autoMapInputData", "value": {}, "matchingColumns": [], "schema": [] },
        "options": {}
      },
      "id": "alia-gcal-logreq",
      "name": "Log Request (GCal)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [220, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": { "__rl": true, "value": "primary", "mode": "list", "cachedResultName": "primary" },
        "returnAll": false,
        "limit": 20,
        "timeMin": "={{ $json.start }}",
        "timeMax": "={{ $json.end }}",
        "options": { "singleEvents": true }
      },
      "id": "alia-gcal-conflicts",
      "name": "Check Conflicts (GCal)",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [440, 300],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Google Calendar getAll returns events OVERLAPPING [timeMin, timeMax].\n// alwaysOutputData is on, so an empty window still yields one empty item — filter it out.\nconst req = $('Build Request').first().json;\nconst events = $input.all().filter(i => i.json && i.json.id);\n\nconst lines = events.map(e => {\n  const s = e.json.start?.dateTime || e.json.start?.date || '?';\n  return `• ${e.json.summary || '(untitled)'} — ${s}`;\n});\n\nreturn [{\n  json: {\n    ...req,\n    conflict_count: lines.length,\n    conflicts: lines.length ? lines.join('\\n') : 'None',\n  },\n}];"
      },
      "id": "alia-gcal-summarise",
      "name": "Summarise Conflicts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "message": "=*ALIA — Approval required (T2)*\n\n*Action:* Create Google Calendar event\n*Request:* {{ $json.request_id }}\n\n*Title:* {{ $json.title }}\n*Start:* {{ $json.start }}\n*End:* {{ $json.end }}\n*Attendees:* {{ $json.attendees || '(none)' }}\n\n⚠️ *Conflicts in this window: {{ $json.conflict_count }}*\n{{ $json.conflicts }}",
        "operation": "sendAndWait",
        "responseType": "approval",
        "approvalOptions": {
          "values": { "approvalType": "double", "approveLabel": "✅ Approve & Create", "disapproveLabel": "❌ Reject" }
        },
        "options": { "limitWaitTime": true, "resumeAmount": 30, "resumeUnit": "minutes", "appendAttribution": false }
      },
      "id": "alia-gcal-approval",
      "name": "Request Approval (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [880, 300],
      "webhookId": "alia-gcal-approval"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.data.approved }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "alia-gcal-approved",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "calendar": { "__rl": true, "value": "primary", "mode": "list", "cachedResultName": "primary" },
        "start": "={{ $('Summarise Conflicts').item.json.start }}",
        "end": "={{ $('Summarise Conflicts').item.json.end }}",
        "additionalFields": {
          "summary": "={{ $('Summarise Conflicts').item.json.title }}",
          "description": "={{ $('Summarise Conflicts').item.json.description }}",
          "attendees": "={{ ($('Summarise Conflicts').item.json.attendees || '').split(',').map(s => s.trim()).filter(Boolean) }}"
        }
      },
      "id": "alia-gcal-create",
      "name": "Create Event (GCal)",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [1340, 180]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "s1", "name": "request_id", "value": "={{ $('Summarise Conflicts').item.json.request_id }}", "type": "string" },
            { "id": "s2", "name": "channel", "value": "google_calendar", "type": "string" },
            { "id": "s3", "name": "tier", "value": "T2", "type": "string" },
            { "id": "s4", "name": "title", "value": "={{ $('Summarise Conflicts').item.json.title }}", "type": "string" },
            { "id": "s5", "name": "conflict_count", "value": "={{ $('Summarise Conflicts').item.json.conflict_count }}", "type": "string" },
            { "id": "s6", "name": "decision", "value": "approved", "type": "string" },
            { "id": "s7", "name": "outcome", "value": "created", "type": "string" },
            { "id": "s8", "name": "decided_at", "value": "={{ $now.toISO() }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "alia-gcal-out-ok",
      "name": "Outcome: Created",
