    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\n// --- shared helpers (inline: n8n Code nodes cannot import) ---\n\n// Deterministic content hash for idempotency.\n// Execution id is NOT a usable idempotency key: a double form submit creates two\n// executions with two different ids, so it could never match. The key must be\n// derived from the CONTENT of the request.\nfunction fnv1a(str) {\n  let h = 0x811c9dc5;\n  for (let i = 0; i < str.length; i++) {\n    h ^= str.charCodeAt(i);\n    h = Math.imul(h, 0x01000193) >>> 0;\n  }\n  return ('00000000' + h.toString(16)).slice(-8);\n}\nfunction dedupeKey(parts) {\n  const norm = parts\n    .map(function (p) { return String(p == null ? '' : p).trim().toLowerCase().replace(/\\s+/g, ' '); })\n    .join('|~|');\n  const rev = norm.split('').reverse().join('');\n  return fnv1a(norm) + fnv1a(rev) + String(norm.length);\n}\n\n// n8n hardcodes parse_mode 'Markdown' on sendAndWait. Legacy Markdown throws\n// \"Bad Request: can't parse entities\" on any unmatched * _ ` [ ] \u2014 which real\n// email WILL contain. Escaping is unreliable in legacy mode, so neutralise the\n// characters instead. Costs a little fidelity, never a failed send.\nfunction mdSafe(s) {\n  return String(s == null ? '' : s).replace(/[*_`\\[\\]]/g, ' ');\n}\n\n// Where we control parse_mode we use HTML, whose escaping is total and lossless.\nfunction htmlEsc(s) {\n  return String(s == null ? '' : s)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n}\n\n// Prefix U+200F so a mixed LTR-label / RTL-content line renders right-to-left.\nfunction rtlMark(s) {\n  const str = String(s == null ? '' : s);\n  const ARABIC = /[\u0600-\u06ff\u0750-\u077f\u08a0-\u08ff\ufb50-\ufdff\ufe70-\ufeff]/;\n  return ARABIC.test(str) ? '\u200f' + str : str;\n}\n\n// Telegram hard-caps a message at 4096 chars. Split on paragraph, then line, then\n// hard-cut, so a long email is delivered in full across several messages rather\n// than failing to send.\nfunction chunk(text,