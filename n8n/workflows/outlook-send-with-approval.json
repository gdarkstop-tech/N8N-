    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\n// The Data Table 'get' replaces our context, so pull it back from the build node.\n// alwaysOutputData means an empty result still emits one item with no columns;\n// only rows carrying a real dedupe_key count as a genuine prior success.\nconst ctx = $('Build & Validate').first().json;\nconst hits = $input.all().filter(function (i) {\n  return i.json && i.json.dedupe_key;\n});\nreturn [{ json: Object.assign({}, ctx, { is_duplicate: hits.length > 0 }) }];\n"
      },
