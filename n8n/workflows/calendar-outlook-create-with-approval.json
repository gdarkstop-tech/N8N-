    {
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "fromAllCalendars": true,
        "startDateTime": "={{ $json.start }}",
        "endDateTime": "={{ $json.end }}",
        "returnAll": false,
        "limit": 20,
        "output": "simple",
        "filters": {}
      },
      "id": "alia-ocal-conflicts",
      "name": "Check Conflicts (OCal)",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Outlook event:getAll (output=simple) returns events overlapping the window.\n// alwaysOutputData is on upstream, so an empty window still yields one empty item.\nconst req = $('Build Request').first().json;\nconst events = $input.all().filter(i => i.json && i.json.id);\n\nconst lines = events.map(e => {\n  const s = e.json.start?.dateTime || e.json.start || '?';\n  return `\u2022 ${e.json.subject || '(untitled)'} \u2014 ${s}`;\n});\n\nreturn [{\n  json: {\n    ...req,\n    conflict_count: lines.length,\n    conflicts: lines.length ? lines.join('\\n') : 'None',\n  },\n}];"
      },
      "id": "alia-gcal-summarise",
      "name": "Summarise Conflicts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "message": "=*ALIA \u2014 Approval required (T2)*\n\n*Action:* Create Outlook Calendar event\n*Request:* {{ $json.request_id }}\n\n*Title:* {{ $json.title }}\n*Start:* {{ $json.start }}\n*End:* {{ $json.end }}\n*Attendees:* {{ $json.attendees || '(none)' }}\n\n\u26a0\ufe0f *Conflicts in this window: {{ $json.conflict_count }}*\n{{ $json.conflicts }}",
        "operation": "sendAndWait",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "\u2705 Approve & Create",
            "disapproveLabel": "\u274c Reject"
          }
        },
        "chatApproval": true,
        "approverIds": "YOUR_TELEGRAM_USER_ID",
        "unauthorizedReplyText": "You are not authorised to approve ALIA actions.",
        "postDecisionBehavior": "showOutcome",
        "options": {
          "limitWaitTime": true,
          "resumeAmount": 30,
          "resumeUnit": "minutes",
          "appendAttribution": false
        }
      },
      "id": "alia-ocal-approval",
      "name": "Request Approval (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        300
      ],
      "webhookId": "alia-ocal-approval"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
